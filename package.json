{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:en && npm run build:zh",
    "build:en": "hexo clean --config _config.yml,_config.en.yml --output .hexo-db/en && hexo generate --config _config.yml,_config.en.yml --output .hexo-db/en",
    "build:zh": "hexo clean --config _config.yml,_config.zh.yml --output .hexo-db/zh && hexo generate --config _config.yml,_config.zh.yml --output .hexo-db/zh",
    "clean": "hexo clean --config _config.yml,_config.en.yml --output .hexo-db/en && hexo clean --config _config.yml,_config.zh.yml --output .hexo-db/zh",
    "deploy": "hexo deploy",
    "new": "hexo new --config _config.yml,_config.en.yml",
    "new:zh": "hexo new --config _config.yml,_config.zh.yml",
    "server": "hexo server --config _config.yml,_config.en.yml --output .hexo-db/en"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-render-pug": "^2.1.4",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0"
  }
}
