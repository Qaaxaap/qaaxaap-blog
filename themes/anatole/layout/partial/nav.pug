.page-top.animated.fadeInDown
  .nav
    li
      if is_home()
        a.current(href=url_for('/'))= __('Home')
      else
        a(href=url_for('/'))= __('Home')
    li
      if is_current('about')
        a.current(href=url_for('about'))= __('About')
      else
        a(href=url_for('about'))= __('About')
    li
      if is_archive()
        a.current(href=url_for('archives'))= __('Archive')
      else
        a(href=url_for('archives'))= __('Archive')
    li
      if is_current('links')
        a.current(href=url_for('links'))= __('Links')
      else
        a(href=url_for('links'))= __('Links')
    if config.alt_lang
      li
        a.lang-switch(href=page.alt_url || config.alt_lang.root)= config.alt_lang.label
  .information
    .back_btn
      li
        if is_post()
          a.fa.fa-chevron-left(onclick="window.history.go(-1)") 
        else
          a.fa.fa-chevron-left(onclick="window.history.go(-1)",style="display:none;") 
    .avatar
      img(src=theme.avatar)
